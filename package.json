{
  "name": "opencode-gitwt",
  "version": "0.2.1",
  "description": "Git worktree tools for OpenCode, powered by gitwt",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./server": "./src/index.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.14.0",
    "opencode": ">=1.19.3 <2"
  },
  "scripts": {
    "check": "biome check .",
    "test": "node --test",
    "release": "node scripts/release.js"
  },
  "dependencies": {
    "@voischev/gitwt": "^0.1.4",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voischev/opencode-gitwt.git"
  },
  "homepage": "https://github.com/voischev/opencode-gitwt",
  "bugs": {
    "url": "https://github.com/voischev/opencode-gitwt/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "git",
    "worktree"
  ],
  "license": "MIT"
}
